{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "preset": "recommended",
      "source": {
        "preset": "recommended",
        "organizeImports": {
          "level": "on",
          "options": {}
        }
      }
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "!**/dist",
      "!**/.next",
      "!next-env.d.ts",
      "!components/ui",
      "!**/*.svg"
    ],
    "maxSize": 5242880
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 30
          }
        },
        "noUselessCatchBinding": "error"
      },
      "suspicious": {
        "noConsole": "off",
        "noLeakedRender": "error",
        "noUnnecessaryConditions": "error",
        "noShadow": "error"
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDestructuring": "error",
        "noIncrementDecrement": "error"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "error",
        "noImgElement": "warn"
      }
    }
  },
  "css": {
    "linter": {
      "enabled": false
    },
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["app/api/og/route.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    }
  ]
}
