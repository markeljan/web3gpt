NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_BLOCKSCOUT_API_KEY=
NEXT_PUBLIC_ETHERSCAN_API_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_TENDERLY_API_KEY=
BLOCKSCOUT_API_KEY=
ETHERSCAN_API_KEY=
# Server-only; used for ENS/Unstoppable Domains resolution.
# NEXT_PUBLIC_INFURA_API_KEY is still read as a legacy fallback.
INFURA_API_KEY=

# Create a GitHub OAuth app with the callback URL
# http://localhost:3000/api/auth/callback/github and sign-in works locally with
# no further setup. Anything other than this project's own OAuth app skips the
# production callback proxy automatically.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
CRON_SECRET=

DEPLOYER_PRIVATE_KEY=
POLYGON_AMOY_RPC_URL=
POLYGON_MAINNET_RPC_URL=

# Upstash Redis. UPSTASH_REDIS_REST_URL/TOKEN win when both are set; otherwise the
# legacy Vercel KV names KV_REST_API_URL/TOKEN are used.
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
KV_REST_API_TOKEN=
KV_REST_API_URL=

OPENAI_API_KEY=

PINATA_JWT=

# Optional overrides for request and deployment limits (defaults in lib/rate-limit.ts).
# The server wallet pays gas for agent deployments; these bound what callers can spend.
MAINNET_DEPLOY_DAILY_LIMIT=
MAINNET_DEPLOY_DAILY_LIMIT_PER_CALLER=
TESTNET_DEPLOY_HOURLY_LIMIT_PER_CALLER=
RATE_LIMIT_CHAT_ANON=
RATE_LIMIT_CHAT_USER=
RATE_LIMIT_SKILL=
RATE_LIMIT_SKILL_CHAT=
RATE_LIMIT_SKILL_READ=
RATE_LIMIT_COMPILE=
RATE_LIMIT_FINALIZE=
