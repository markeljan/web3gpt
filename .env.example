# Copy to .env.local and fill in. The README explains each variable.

# ── Required ──────────────────────────────────────────────────────────────────

# Model provider
OPENAI_API_KEY=

# Redis REST endpoint (Upstash): chats, agents, deployments, rate limits.
# Set one pair. UPSTASH_REDIS_REST_* (Upstash / Vercel marketplace integration) wins
# when both are set; KV_REST_API_* (legacy Vercel KV names) is the fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Wallet that pays for agent deployments: hex private key without 0x
DEPLOYER_PRIVATE_KEY=

# GitHub sign-in. For local development, create a GitHub OAuth app with the callback
# http://localhost:3000/api/auth/callback/github. AUTH_SECRET is any long random string.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

# IPFS: Pinata JWT, and the public gateway used in links, with protocol
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=

# WalletConnect / Reown project id for RainbowKit
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Authenticates the Vercel cron that runs contract verification
CRON_SECRET=

# ── Recommended ───────────────────────────────────────────────────────────────

# RPC providers (public RPCs are used as fallbacks)
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_TENDERLY_API_KEY=

# Contract verification
ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# ENS / Unstoppable Domains resolution (server-only)
INFURA_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# OpenAI model for every agent (default: gpt-6-luna). e.g. gpt-6.1-sol for stronger
# Solidity at roughly 20x the cost.
AI_MODEL=

# RPC overrides
POLYGON_MAINNET_RPC_URL=
POLYGON_AMOY_RPC_URL=
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=

# Limits (defaults in lib/rate-limit.ts). The server wallet pays gas for agent
# deployments; these bound what callers can spend.
MAINNET_DEPLOY_DAILY_LIMIT=
MAINNET_DEPLOY_DAILY_LIMIT_PER_CALLER=
TESTNET_DEPLOY_HOURLY_LIMIT_PER_CALLER=
RATE_LIMIT_CHAT_ANON=
RATE_LIMIT_CHAT_USER=
RATE_LIMIT_SKILL=
RATE_LIMIT_SKILL_CHAT=
RATE_LIMIT_SKILL_READ=
RATE_LIMIT_COMPILE=
RATE_LIMIT_FINALIZE=

# Legacy names, still read as fallbacks by older deployments:
# NEXT_PUBLIC_INFURA_API_KEY, NEXT_PUBLIC_ETHERSCAN_API_KEY, NEXT_PUBLIC_BLOCKSCOUT_API_KEY,
# BETTER_AUTH_GITHUB_ID, BETTER_AUTH_GITHUB_SECRET, BETTER_AUTH_SECRET
